+#ifdef __EMSCRIPTEN__
+/**
+ * Lets the pointer lock go once the local player is out of the creature, however they left it.
+ * Only a right-click or Escape (PI_DirctCtLeave) announces MG_OnPossessionLeave; a creature that
+ * dies while it is being entered, one scared into passenger view, or a lost level takes the player
+ * out without a word, and the page would hold the lock in the keeper's view. While the possess
+ * instance (PI_DirctCtrl) runs, the view is not yet the creature's, so that counts as possessing.
+ */
+static void web_let_go_after_possession(void)
+{
+    if (!web_possessing)
+        return;
+    struct PlayerInfo* player = get_my_player();
+    if ((player->view_type == PVT_CreatureContrl) || (player->instance_num == PI_DirctCtrl))
+        return;
+    LbGrabMouseCheck(MG_OnPossessionLeave);
+}
+#endif
